{
  "manifest_version": 3,
  "name": "Telegram Chat Summary",
  "version": "1.0.0",
  "description": "Summarize your Telegram chats with OpenAI!",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.telegram.org/*",
    "https://generativelanguage.googleapis.com/"
  ],
  "action": {
    "default_title": "Telegram Chat Summary",
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["static/js/content.js"], 
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "static/js/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["static/js/*.js", "static/css/*.css"],
      "matches": ["https://web.telegram.org/*"]
    }
  ]
}